{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thia.example/gestalts/topic/v1.json",
  "title": "Topic",
  "description": "A named subject for connecting activities and records. Consumers can create topics locally by name.",
